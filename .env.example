# Names only. Real values live in .env.local (git-ignored) and in the Vercel project settings.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# The app needs Disputes and Transaction search enabled. Sandbox only, never live credentials.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same value as PAYPAL_CLIENT_ID. Used by the JS SDK v6 on the demo store page.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Sandbox personal (buyer) account that pays seed orders and opens disputes. Used only by `pnpm seed`.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# Printed by `pnpm paypal:webhook <public-url>`. Needed for webhook signature verification.
PAYPAL_WEBHOOK_ID=

# OpenAI-compatible inference (W&B Inference). Server-side only.
OPENAI_BASE_URL=https://api.inference.wandb.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=Qwen/Qwen3.8-27B
OPENAI_VISION_MODEL=google/gemma-4-31B-it
OPENAI_FALLBACK_MODEL=zai-org/GLM-5.3-Flash

# ElevenLabs. Only used by the video and voice-line scripts, never by the running app.
ELEVENLABS_API_KEY=

# Generate yourself, for example: openssl rand -hex 24. Protects POST /api/admin/reset.
DEMO_ADMIN_TOKEN=

# Set automatically when a Vercel Blob store is connected. Without it, state is kept in .data/.
BLOB_READ_WRITE_TOKEN=
